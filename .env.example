# Copy to .env in the repo root (gitignored). Do not commit real values.
# Loaded automatically on startup; existing shell exports win.

# Listen (8080 is often taken by other Node apps)
# KLIMAT_LISTEN=:8081

# Embedder: fake | onnx | auto   (production: onnx + docs/SELFHOST.md)
# KLIMAT_EMBEDDER=onnx
# KLIMAT_RERANKER=none
# KLIMAT_MODELS=./models
# KLIMAT_EMBEDDING_MODEL=f2llm-v2-80m

# Billing env is ignored unless you build with -tags hosted (make build-hosted).
# Unkey — server root key from the Unkey dashboard (Settings → Root Keys).
# This is NOT a customer API key. It lets klimatsearch VerifyKey.
# UNKEY_ROOT_KEY=unkey_xxxxxxxx

# Optional extra lock on POST /admin/ingest/file
# KLIMAT_ADMIN_TOKEN=

# MPP agent lane (github.com/tempoxyz/mpp-go). Unpaid requests get HTTP 402
# with WWW-Authenticate: Payment. Developers still use Unkey Bearer.
# Generate the secret locally (not from a dashboard): openssl rand -hex 32
# Recipient is a Tempo address you control (npx mppx account create --network testnet).
# MPP_SECRET_KEY=
# MPP_RECIPIENT=0x
# MPP_RPC_URL=https://rpc.moderato.tempo.xyz
# MPP_REALM=klimatsearch
# MPP_AMOUNT=0.01

# Outbound webhook when ingest upserts a changed Resource (ContentHash).
# Comma-separated URLs. Secret is HMAC-SHA256 of the JSON body (X-Klimat-Signature).
# KLIMAT_WEBHOOK_URL=https://example.com/hooks/klimat
# KLIMAT_WEBHOOK_SECRET=

# ONNX Runtime (macOS Homebrew, or Linux ./scripts/fetch-onnxruntime.sh)
# ONNXRUNTIME_LIB=/opt/homebrew/lib/libonnxruntime.dylib
# ONNXRUNTIME_LIB=/usr/local/lib/libonnxruntime.so
