# Copy to .env in the repo root (gitignored). Do not commit real values.
# Loaded automatically on startup; existing shell exports win.

# Listen (8080 is often taken by other Node apps)
# KLIMAT_LISTEN=:8081

# Embedder: fake | onnx | auto
# KLIMAT_EMBEDDER=onnx

# Unkey — server root key from the Unkey dashboard (Settings → Root Keys).
# This is NOT a customer API key. It lets klimatsearch VerifyKey.
# UNKEY_ROOT_KEY=unkey_xxxxxxxx

# Optional extra lock on POST /admin/ingest/file
# KLIMAT_ADMIN_TOKEN=

# ZeroClick (agent lane) — only when you have a seller account
# ZEROCLICK_SIGNING_SECRETS=
# ZEROCLICK_API_KEY=
# ZEROCLICK_STOREFRONT_URL=https://...

# ONNX Runtime if not in the default Homebrew path
# ONNXRUNTIME_LIB=/opt/homebrew/lib/libonnxruntime.dylib
